generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int     @id @default(autoincrement())
  username     String
  email        String @unique
  password     String
  role         String
  refreshToken String?


  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
