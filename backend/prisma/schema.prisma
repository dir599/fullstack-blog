generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int     @id @default(autoincrement())
  username     String @unique
  email        String  @unique
  password     String
  fullname     String
  avatar       String?
  bio          String?
  role         Role    @default(USER)
  refreshToken String?
  
  blogs Blog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum Role {
  USER
  ADMIN
}

model Blog {
  id Int @id @default(autoincrement())
  title String
  description String
  coverImage String?

  authorId Int
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()

  @@map("blogs")
}
